# Backend Dockerfile
FROM golang:1.25.10-alpine AS builder workerscheduler

WORKDIR /app

# Copy dependencies (cached by Docker)
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Compile dengan CGO enabled false (optimasi)
RUN CGO_ENABLED=0 go build -o /app/api ./cmd/api

FROM alpine:latest

WORKDIR /app

# Copy binary compilation
COPY --from=builder /app/api /app/api

# Directory file env template
COPY docker/development/.env.api.example /app/.env.example

EXPOSE 8080

# Health check (cek apakah API nyala)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

CMD ["/app/api"]