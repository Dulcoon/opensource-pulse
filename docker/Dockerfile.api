# Backend Development Dockerfile with Air (Live-Reload)
FROM golang:alpine

WORKDIR /app

# Install air for live reload and git
RUN apk add --no-cache git && \
    go install github.com/air-verse/air@latest

# Copy go module definitions
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

EXPOSE 9001

# Health check
HEALTHCHECK --interval=5s --timeout=3s --start-period=30s --retries=5 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:9001/health || exit 1

CMD ["air", "-c", ".air.toml"]