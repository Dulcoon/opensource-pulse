# Frontend Dockerfile
FROM node:22-alpine AS builder

WORKDIR /app

# Install production dependencies
COPY package*.json ./
RUN npm ci --only=production

# Copy source code
COPY . .

# Build production
ENV NODE_ENV=production
RUN npm run build

# Runtime cho preview server
FROM node:22-alpine

WORKDIR /app

# Copy built files
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/tsconfig.json ./
COPY docker/development/.env.web.example /app/.env.example

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD [ "-c", "test -f /app/dist/client/index.html" ] || exit 1

CMD [ "node", "dist/server/preview.mjs" ]