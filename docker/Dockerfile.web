# Frontend PRODUCTION Dockerfile (multi-stage).
# Build context is the REPO ROOT (see docker-compose.yml).
# Stage 1 builds the TanStack Start production bundle (SSR + client).
# Stage 2 runs it with `vite preview` (minified, no HMR, no dev middleware).
# NOTE: VITE_API_URL is baked at BUILD time (Vite embeds VITE_* into the
# bundle). Changing the API host requires rebuilding this image.

# ============ Stage 1: build ============
FROM node:22-alpine AS build

WORKDIR /app

COPY apps/web/package*.json ./
RUN npm ci --legacy-peer-deps

COPY apps/web/ ./

ARG VITE_API_URL=http://localhost:9001/api
ENV VITE_API_URL=${VITE_API_URL}
ENV NODE_ENV=production

RUN npm run build

# ============ Stage 2: serve ============
FROM node:22-alpine

WORKDIR /app

COPY --from=build --chown=node:node /app/package*.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/vite.config.ts ./
# vite preview re-resolves the router entry from source at startup.
COPY --from=build --chown=node:node /app/src ./src
COPY --from=build --chown=node:node /app/tsconfig.json ./

USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "3000"]
